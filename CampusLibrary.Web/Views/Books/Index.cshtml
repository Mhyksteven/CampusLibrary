
@model IEnumerable<CampusLibrary.Domain.Entities.Book>

@{
    ViewData["Title"] = "Book Management";
    var books = Model?.ToList()
        ?? new List<CampusLibrary.Domain.Entities.Book>();

    var totalTitles = books.Count;
    var totalCopies = books.Sum(b => b.TotalCopies);
    var availableCopies = books.Sum(b => b.AvailableCopies);
}

<div class="dashboard-heading">
    <div>
        <div style="color:#64748b;font-size:13px;margin-bottom:7px">
            Library Management / Collection
        </div>
        <h2 style="margin-bottom:7px">Book Management</h2>
        <p>Monitor and manage your campus library collection.</p>
    </div>

    <a asp-action="Create" class="btn btn-primary">
        + Add New Book
    </a>
</div>

<div class="metric-grid">
    <div class="metric-card">
        <div class="metric-icon">📚</div>
        <div class="metric-label">Total Book Titles</div>
        <div class="metric-value">@totalTitles</div>
    </div>

    <div class="metric-card">
        <div class="metric-icon">📖</div>
        <div class="metric-label">Total Copies</div>
        <div class="metric-value">@totalCopies</div>
    </div>

    <div class="metric-card">
        <div class="metric-icon">✅</div>
        <div class="metric-label">Available Copies</div>
        <div class="metric-value">@availableCopies</div>
    </div>
</div>

<div class="panel-card">
    <div class="panel-heading">
        <div>
            <h3>Book Collection</h3>
            <small class="text-muted">
                @totalTitles book title(s) in the library
            </small>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table">
            <thead>
                <tr>
                    <th>Book Title</th>
                    <th>Author</th>
                    <th>ISBN</th>
                    <th>Year</th>
                    <th>Total</th>
                    <th>Available</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var book in books)
                {
                    <tr>
                        <td>
                            <strong>@book.Title</strong>
                        </td>
                        <td>@book.Author</td>
                        <td>@book.ISBN</td>
                        <td>@book.PublicationYear</td>
                        <td>@book.TotalCopies</td>
                        <td>
                            @if (book.AvailableCopies > 0)
                            {
                                <span class="badge bg-success">
                                    @book.AvailableCopies available
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">
                                    Unavailable
                                </span>
                            }
                        </td>
                        <td>
                            <div class="action-links">
                                <a asp-action="Details"
                                   asp-route-id="@book.Id">
                                    View
                                </a>
                                <a asp-action="Edit"
                                   asp-route-id="@book.Id">
                                    Edit
                                </a>
                                <a asp-action="Delete"
                                   asp-route-id="@book.Id"
                                   class="text-danger">
                                    Delete
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        @if (!books.Any())
        {
            <div class="text-center py-5">
                <h4>No books added yet</h4>
                <p class="text-muted">
                    Start building your campus collection.
                </p>
                <a asp-action="Create"
                   class="btn btn-primary">
                    Add Your First Book
                </a>
            </div>
        }
    </div>
</div>
